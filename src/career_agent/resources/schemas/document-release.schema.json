{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "relative_path",
        "checksum"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ArtifactType": {
      "enum": [
        "resume_pdf",
        "cover_letter_pdf",
        "resume_docx",
        "cover_letter_docx"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "ClaimReference": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^CLAIM-\\d{4}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Evidence Sources",
          "type": "array"
        },
        "fact_ids": {
          "default": [],
          "items": {
            "pattern": "^FACT-\\d{4}$",
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id"
      ],
      "title": "ClaimReference",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Explicit pointer to evidence outside the current record.",
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "checksum": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "exact_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Text"
        },
        "extractor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor"
        },
        "extractor_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Version"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "normalized_text_checksum": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Text Checksum"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        }
      },
      "required": [
        "source_id",
        "locator"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "ValidationSummary": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "$ref": "#/$defs/ArtifactType"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "report_checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Report Checksum",
          "type": "string"
        },
        "report_path": {
          "minLength": 1,
          "title": "Report Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "passed",
        "report_path",
        "report_checksum"
      ],
      "title": "ValidationSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "pattern": "^APP-\\d{4}-\\d{4}$",
      "title": "Application Id",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClaimReference"
      },
      "title": "Claims",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "idempotency_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Idempotency Digest",
      "type": "string"
    },
    "release_id": {
      "pattern": "^REL-\\d{4}$",
      "title": "Release Id",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "validation_reports": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ValidationSummary"
      },
      "title": "Validation Reports",
      "type": "array"
    }
  },
  "required": [
    "release_id",
    "application_id",
    "artifacts",
    "request_digest",
    "idempotency_digest"
  ],
  "title": "DocumentRelease",
  "type": "object"
}
