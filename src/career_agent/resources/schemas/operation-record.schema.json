{
  "$defs": {
    "OperationStatus": {
      "enum": [
        "started",
        "committed",
        "failed"
      ],
      "title": "OperationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checkpoints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "operation": {
      "minLength": 1,
      "title": "Operation",
      "type": "string"
    },
    "result_references": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Result References",
      "type": "array"
    },
    "run_id": {
      "pattern": "^RUN-\\d{4}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/OperationStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "operation",
    "idempotency_key",
    "status"
  ],
  "title": "OperationRecord",
  "type": "object"
}
