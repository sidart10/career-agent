{
  "$defs": {
    "ResetScope": {
      "enum": [
        "generated_drafts",
        "temporary_files",
        "integrations",
        "imported_sources",
        "releases",
        "submission_evidence",
        "all_personal_workspace_data",
        "remote_data"
      ],
      "title": "ResetScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deleted_paths": {
      "items": {
        "type": "string"
      },
      "title": "Deleted Paths",
      "type": "array"
    },
    "plan_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Plan Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scopes": {
      "items": {
        "$ref": "#/$defs/ResetScope"
      },
      "title": "Scopes",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "plan_digest",
    "scopes",
    "deleted_paths"
  ],
  "title": "ResetResult",
  "type": "object"
}
