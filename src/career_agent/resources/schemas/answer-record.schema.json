{
  "$defs": {
    "JsonValue": {},
    "RetentionClass": {
      "enum": [
        "ordinary",
        "contextual",
        "high_risk",
        "sensitive",
        "prohibited"
      ],
      "title": "RetentionClass",
      "type": "string"
    },
    "ReusePolicy": {
      "enum": [
        "stable",
        "verify_on_conflict",
        "verify_per_jurisdiction",
        "verify_per_application",
        "application_only",
        "expires_after"
      ],
      "title": "ReusePolicy",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aliases": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "answer_id": {
      "pattern": "^ANS-\\d{4}$",
      "title": "Answer Id",
      "type": "string"
    },
    "confirmed_at": {
      "format": "date-time",
      "title": "Confirmed At",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "exact_user_response": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonValue"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "question_id": {
      "minLength": 1,
      "title": "Question Id",
      "type": "string"
    },
    "retention_class": {
      "$ref": "#/$defs/RetentionClass"
    },
    "reuse_policy": {
      "$ref": "#/$defs/ReusePolicy"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Scope",
      "type": "object"
    },
    "source_reference": {
      "minLength": 1,
      "title": "Source Reference",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/JsonValue"
    }
  },
  "required": [
    "answer_id",
    "question_id",
    "value",
    "source_reference",
    "retention_class",
    "reuse_policy",
    "confirmed_at"
  ],
  "title": "AnswerRecord",
  "type": "object"
}
