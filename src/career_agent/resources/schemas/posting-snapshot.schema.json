{
  "$defs": {
    "PostingAvailability": {
      "enum": [
        "open",
        "closed",
        "unknown"
      ],
      "title": "PostingAvailability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "pattern": "^APP-\\d{4}-\\d{4}$",
      "title": "Application Id",
      "type": "string"
    },
    "availability": {
      "$ref": "#/$defs/PostingAvailability",
      "default": "unknown"
    },
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Checksum",
      "type": "string"
    },
    "compensation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compensation"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deadline": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline"
    },
    "eligibility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Eligibility"
    },
    "location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "normalized_text": {
      "title": "Normalized Text",
      "type": "string"
    },
    "raw_text": {
      "title": "Raw Text",
      "type": "string"
    },
    "requisition_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requisition Id"
    },
    "responsibilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Responsibilities",
      "type": "array"
    },
    "retrieved_at": {
      "format": "date-time",
      "title": "Retrieved At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "pattern": "^PST-\\d{4}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_adapter": {
      "title": "Source Adapter",
      "type": "string"
    },
    "source_adapter_metadata": {
      "additionalProperties": true,
      "title": "Source Adapter Metadata",
      "type": "object"
    },
    "source_url": {
      "format": "uri",
      "minLength": 1,
      "title": "Source Url",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "application_id",
    "raw_text",
    "normalized_text",
    "source_url",
    "retrieved_at",
    "checksum",
    "source_adapter"
  ],
  "title": "PostingSnapshot",
  "type": "object"
}
