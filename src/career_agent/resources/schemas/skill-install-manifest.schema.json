    "source_revision": {
      "minLength": 1,
      "title": "Source Revision",
      "type": "string"
    },
    "supported_cli_range": {
      "minLength": 1,
      "title": "Supported Cli Range",
      "type": "string"
    },
    "updated_at": {
      "minLength": 1,
      "title": "Updated At",
      "type": "string"
    }
