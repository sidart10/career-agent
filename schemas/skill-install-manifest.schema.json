{
  "additionalProperties": false,
  "properties": {
    "canonical_source": {
      "minLength": 1,
      "title": "Canonical Source",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "installed_targets": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "title": "Installed Targets",
      "type": "object"
    },
    "mode": {
      "enum": [
        "link",
        "mirror"
      ],
      "title": "Mode",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Checksum",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "mode",
    "canonical_source",
    "source_checksum",
    "installed_targets"
  ],
  "title": "SkillInstallManifest",
  "type": "object"
}
