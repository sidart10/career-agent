{
  "$defs": {
    "ConfirmationState": {
      "enum": [
        "proposed",
        "confirmed",
        "rejected"
      ],
      "title": "ConfirmationState",
      "type": "string"
    },
    "ExtractionStatus": {
      "enum": [
        "extracted",
        "failed",
        "unsupported"
      ],
      "title": "ExtractionStatus",
      "type": "string"
    },
    "FactConflict": {
      "additionalProperties": false,
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/ProposedFact"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "conflict_id": {
          "title": "Conflict Id",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "resolved_fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Fact Id"
        }
      },
      "required": [
        "conflict_id",
        "key",
        "alternatives"
      ],
      "title": "FactConflict",
      "type": "object"
    },
    "ImportedSource": {
      "additionalProperties": false,
      "properties": {
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "extraction_status": {
          "$ref": "#/$defs/ExtractionStatus"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_paths": {
          "items": {
            "type": "string"
          },
          "title": "Source Paths",
          "type": "array"
        },
        "stored_path": {
          "title": "Stored Path",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "checksum",
        "source_paths",
        "stored_path",
        "media_type",
        "extraction_status"
      ],
      "title": "ImportedSource",
      "type": "object"
    },
    "JsonValue": {},
    "ProfileFact": {
      "additionalProperties": false,
      "properties": {
        "confirmation_state": {
          "$ref": "#/$defs/ConfirmationState",
          "default": "proposed"
        },
        "confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmed At"
        },
        "confirmer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confirmer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "fact_id": {
          "pattern": "^FACT-\\d{4}$",
          "title": "Fact Id",
          "type": "string"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "fact_id",
        "key",
        "value"
      ],
      "title": "ProfileFact",
      "type": "object"
    },
    "ProposedFact": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Id"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "title": "Sources",
          "type": "array"
        },
        "supported": {
          "default": true,
          "title": "Supported",
          "type": "boolean"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "proposal_id",
        "key",
        "value",
        "sources"
      ],
      "title": "ProposedFact",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "description": "Explicit pointer to evidence outside the current record.",
      "properties": {
        "checksum": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checksum"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "locator"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied_runs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Applied Runs",
      "type": "array"
    },
    "conflicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FactConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProfileFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "imported_sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ImportedSource"
      },
      "title": "Imported Sources",
      "type": "array"
    },
    "proposals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedFact"
      },
      "title": "Proposals",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "title": "ProfileState",
  "type": "object"
}
