{
  "$defs": {
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "limitations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_reference": {
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "level",
        "source_reference",
        "confidence"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "planned",
        "observed",
        "employer_confirmed"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "SubmissionResolution": {
      "enum": [
        "confirmed",
        "unsuccessful"
      ],
      "title": "SubmissionResolution",
      "type": "string"
    },
    "SubmissionStatus": {
      "enum": [
        "none",
        "in_progress",
        "uncertain",
        "confirmed"
      ],
      "title": "SubmissionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "pattern": "^APR-\\d{4}$",
      "title": "Approval Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceClaim"
      },
      "title": "Evidence",
      "type": "array"
    },
    "resolution": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubmissionResolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/SubmissionStatus"
    },
    "submission_id": {
      "pattern": "^SUB-\\d{4}$",
      "title": "Submission Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "submission_id",
    "status",
    "approval_id"
  ],
  "title": "SubmissionAttempt",
  "type": "object"
}
