{
  "$defs": {
    "ArtifactRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "relative_path",
        "checksum"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "ClaimReference": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^CLAIM-\\d{4}$",
          "title": "Claim Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "pattern": "^FACT-\\d{4}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "fact_ids"
      ],
      "title": "ClaimReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "pattern": "^APP-\\d{4}-\\d{4}$",
      "title": "Application Id",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ClaimReference"
      },
      "title": "Claims",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "release_id": {
      "pattern": "^REL-\\d{4}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "application_id",
    "artifacts"
  ],
  "title": "DocumentRelease",
  "type": "object"
}
